rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sustituye por el UID del admin (Authentication > Users > User UID)
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['PEGA_AQUI_EL_UID_DEL_ADMIN'];
    }

    // Catálogo público: cualquiera lee, solo el admin escribe
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Datos privados (precio de inversión): solo admin
    match /products_private/{id} {
      allow read, write: if isAdmin();
    }

    // Sitio (número de WhatsApp público, etc.): cualquiera lee, solo el admin escribe
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
